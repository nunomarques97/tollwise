# Tollwise — .gitignore
# This repository is built to become public open source. Nothing below may ever be committed.
# If you add a new kind of secret or local file, add its pattern here BEFORE creating the file.
# The pre-commit hook in .githooks/ blocks secrets that slip past these patterns.

# ---------------------------------------------------------------- secrets & credentials
.env
.env.*
!.env.example
*.env
.envrc
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_ed25519*
*.ppk
credentials.json
credentials*.json
service-account*.json
google-services.json
GoogleService-Info.plist
*token*
!**/*token*.test.*
!**/*tokenizer*
*secret*
!**/*secret*.test.*
*apikey*
*api_key*
*api-key*
.netrc
.npmrc
.pypirc
auth.json
keys.json
providers.local.*
tollwise.local.*
*.local.yaml
*.local.yml
*.local.json
*.local.toml
scan-public.local.json

# ---------------------------------------------------------------- local runtime data (analytics DB, logs, request captures)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
/logs/
captures/
*.har
/tmp/
/temp/
.tmp*/

# ---------------------------------------------------------------- local assistant settings and session data
.claude/settings.local.json
.claude/*.local.*
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/ide/
CLAUDE.local.md
*.jsonl
transcripts/
sessions/

# ---------------------------------------------------------------- dependencies & build output
node_modules/
.pnpm-store/
.yarn/
dist/
build/
out/
coverage/
.turbo/
.next/
.vite/
*.tsbuildinfo
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
target/

# ---------------------------------------------------------------- editors & OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
*.lnk

